# ---------------------------------------------------------------------------
# Scrapyard configuration
#
# LOCAL:  copy to apps/api/.env and fill in.
# RENDER: render.yaml already declares every one of these. The ones marked
#         `sync: false` there are prompted for in the dashboard. Never commit
#         real values.
# ---------------------------------------------------------------------------

# --- Database (required) ---------------------------------------------------
# MongoDB Atlas connection string. Atlas -> Cluster -> Connect -> Drivers.
# Remember to URL-encode a password containing @ : / ? # [ ] or %.
MONGODB_URI=mongodb+srv://user:pass@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=scrapyard

# --- Google OAuth (required) -----------------------------------------------
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
#   Application type: Web application
#   Authorised REDIRECT URI (not JavaScript origin):
#     http://localhost:3000/api/auth/google/callback
#     https://<your-app>.onrender.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# --- Access (required) ------------------------------------------------------
# Comma-separated Workspace domains allowed to sign in. Re-checked server-side
# on every login. The API refuses to boot if this is empty — there is no open
# sign-in mode.
ALLOWED_WORKSPACE_DOMAINS=cytactic.com

# Comma-separated emails granted admin. Reconciled on EVERY login: listed
# emails are promoted, unlisted ones demoted. Order of sign-up is irrelevant.
# Only if this is empty does the first racer to sign in become admin.
ADMIN_EMAILS=amit@cytactic.com

# --- Session ---------------------------------------------------------------
# Any long random string: openssl rand -hex 32
JWT_SECRET=change-me-to-something-long-and-random

# --- Behaviour --------------------------------------------------------------
# IANA zone that decides when "today" flips for the daily leaderboard.
SCRAPYARD_TIMEZONE=Asia/Jerusalem

# Login background: a YouTube id, or `none` for the animated grid only.
# A file at apps/api/public/login/background.mp4 overrides this.
LOGIN_BACKGROUND_YOUTUBE_ID=xt_1gJkjdec

# --- Local development only -------------------------------------------------
# Render sets PORT=10000 itself; 3000 is just the local default.
PORT=3000

# Points at the Vite dev server. Leave this UNSET anywhere the API also serves
# the bundle (Render, `npm run preview`) so redirects stay relative and CORS
# stays off entirely.
WEB_ORIGIN=http://localhost:5173

# Render terminates TLS at its edge, so the hop to this process is plain HTTP.
# render.yaml sets this; locally you don't want it.
# TRUST_PROXY=true
