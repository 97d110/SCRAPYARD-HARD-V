# ---------------------------------------------------------------------------
# Scrapyard API configuration
# Copy to `.env` (or `.env.local`) and fill in. The API refuses to boot without
# the Google OAuth values — sign-in is strict SSO only, there is no bypass.
# ---------------------------------------------------------------------------

# --- Google OAuth (required) -----------------------------------------------
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
#   Application type: Web application
#   Authorised redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# --- Workspace lockdown (required) -----------------------------------------
# Comma-separated Google Workspace domains allowed to sign in — i.e. only
# *@cytactic.com accounts. Every login is re-checked against this list
# server-side, regardless of what Google returns. The API refuses to boot if
# this is missing or empty; there is no open sign-in mode.
ALLOWED_WORKSPACE_DOMAINS=cytactic.com

# --- Session ---------------------------------------------------------------
# Any long random string. `openssl rand -hex 32` is fine.
JWT_SECRET=change-me-to-something-long-and-random
# Optional: set when API and web are on different subdomains of one site.
# COOKIE_DOMAIN=.cytactic.com
# The session cookie gets the Secure flag automatically when NODE_ENV=production.
# Set this to true if TLS is terminated upstream but NODE_ENV isn't production.
# COOKIE_SECURE=true

# --- Wiring ----------------------------------------------------------------
PORT=3000
# Comma-separated list of allowed browser origins, and the post-login redirect
# target. In DEVELOPMENT this must point at the Vite dev server. In production,
# when this process serves the bundle itself, leave it EMPTY so redirects stay
# relative and work behind any hostname or proxy.
WEB_ORIGIN=http://localhost:5173
# Set to production when deploying — this is what turns on Secure cookies.
# NODE_ENV=production
# Set when a TLS terminator or load balancer sits in front (most PaaS hosts do).
# 'true', a hop count like '1', or a subnet. Leave unset when nothing is in front.
# TRUST_PROXY=1

# --- Login page background -------------------------------------------------
# A file at apps/api/public/login/background.mp4 always wins. Failing that, this
# YouTube id is embedded (default: BlazeRush PS5 gameplay). Set to `none` for
# the animated grid only. See apps/api/public/login/README.md.
LOGIN_BACKGROUND_YOUTUBE_ID=xt_1gJkjdec

# --- Behaviour -------------------------------------------------------------
# IANA timezone that defines when "today" flips for daily leaderboards.
SCRAPYARD_TIMEZONE=Asia/Jerusalem
# Comma-separated emails granted the admin role. This is the single source of
# truth and is reconciled on EVERY login: listed emails are promoted, unlisted
# ones demoted. Order of sign-up doesn't matter.
# Only if this is left empty does the first racer to sign in become admin.
ADMIN_EMAILS=amit@cytactic.com
# Where the JSON database lives. Defaults to apps/api/database.
# DATABASE_DIR=/absolute/path/to/database

# --- Cloudflare Tunnel (only for `docker compose --profile tunnel`) ---------
# Token from Zero Trust -> Networks -> Tunnels -> your tunnel.
# See DEPLOY-CLOUDFLARE.md. Not needed for local development.
# TUNNEL_TOKEN=
