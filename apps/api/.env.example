# ---------------------------------------------------------------------------
# Scrapyard configuration
#
# LOCAL:  copy to apps/api/.env and fill in.
# RENDER: render.yaml already declares every one of these. The ones marked
#         `sync: false` there are prompted for in the dashboard. Never commit
#         real values.
# ---------------------------------------------------------------------------

# --- Database (required) ---------------------------------------------------
# MongoDB Atlas connection string. Atlas -> Cluster -> Connect -> Drivers.
# Remember to URL-encode a password containing @ : / ? # [ ] or %.
MONGODB_URI=mongodb+srv://user:pass@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=scrapyard

# --- Google OAuth (required) -----------------------------------------------
# Any Google Cloud project works — a personal one is fine.
#   Console -> APIs & Services -> OAuth consent screen -> User type: External
#     (while "Testing", only accounts you add under "Test users" can sign in)
#   Console -> Credentials -> Create OAuth client ID -> Web application
#   Authorised REDIRECT URI (not JavaScript origin):
#     http://localhost:3000/api/auth/google/callback
#     https://<your-app>.onrender.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# --- Access (required) ------------------------------------------------------
# Comma-separated allowlist, re-checked server-side on every login. The API
# refuses to boot if this is empty — there is no open sign-in mode.
#
# Each entry is a bare domain OR a glob over the whole email (only `*` is
# special, matched full-string, case-insensitive):
#   cytactic.com          shorthand for *@cytactic.com
#   *@cytactic.com        same, explicit
#   *@*.cytactic.com      any subdomain
#   amit@gmail.com        one specific address
#   amit@gmail.com,*@cytactic.com   mix freely
# A single bare/plain domain also hints Google's account chooser (hd=).
ALLOWED_WORKSPACE_DOMAINS=*@cytactic.com

# Comma-separated emails granted admin. Reconciled on EVERY login: listed
# emails are promoted, unlisted ones demoted. Order of sign-up is irrelevant.
# Only if this is empty does the first racer to sign in become admin.
ADMIN_EMAILS=amit@cytactic.com

# --- Session ---------------------------------------------------------------
# Any long random string: openssl rand -hex 32
JWT_SECRET=change-me-to-something-long-and-random

# --- Data protection ---------------------------------------------------------
# Encrypts each racer's email and Google id at rest (AES-256-GCM) and derives
# the lookup hash used to find them again on login. 32 random bytes, base64:
#   openssl rand -base64 32
# Back this up like JWT_SECRET, but treat it as more critical: losing it makes
# every racer's email/Google id permanently undecryptable, and login stops
# working (it can't be looked up). Rotating it requires re-running the
# migration script against every document, not just restarting the app.
DATA_ENCRYPTION_KEY=

# --- Push notifications (optional) ------------------------------------------
# Web Push. Entirely optional — leave both keys unset and the feature is just
# off: the profile's notification toggle hides itself, nothing else changes.
# Generate the pair once (they're a matched keypair, not two independent
# secrets) and keep them, the same as JWT_SECRET/DATA_ENCRYPTION_KEY:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact info a push service can use to reach you about this key if it's
# misbehaving. Must be an https: URL or a mailto: address.
VAPID_SUBJECT=mailto:admin@example.com

# --- Voice entry (optional) --------------------------------------------------
# Turns a spoken Hebrew summary of a race into filled-in form fields. Optional
# in exactly the way the push keys above are: leave it unset and the mic button
# hides itself, nothing else changes.
#
# Free tier, no card: https://console.groq.com -> API Keys. Keys start "gsk_".
#
# Free-plan limits for gpt-oss-120b, per Groq's own rate-limits page (NOT a
# reseller's blog — several rank highly for "groq free tier" and are neither
# authoritative nor disinterested):
#   30 requests/min · 1,000/day · 8K tokens/min · 200K tokens/day
#
# Tokens per minute is the limit that actually binds here, not requests: one
# extraction is ~600 tokens (system prompt + the whole roster + the transcript),
# so 8K TPM allows roughly 13 a minute. Fine for a crew, but note the roster
# rides along in every request — a much larger one shrinks that number.
GROQ_API_KEY=
# Must be a model that supports strict Structured Outputs, which is what makes
# the response schema-guaranteed rather than merely requested. As of writing
# only the two gpt-oss models qualify; the 20b is the cheaper/faster sibling.
#
# Verified on real spoken Hebrew before shipping: `npm run probe:groq` scored
# 4/4 with this model, including cases with no scores stated (it must not invent
# them). Re-run it if you change this value — Hebrew handling is the thing most
# likely to differ between models, and the probe is the only thing that checks.
GROQ_MODEL=openai/gpt-oss-120b

# Optional: point at any OpenAI-compatible provider instead of Groq. Mostly
# useful for testing an alternative through `npm run probe:groq`. Note that not
# every gateway forwards strict `json_schema` mode — a 400 mentioning
# response_format means that provider only does looser JSON, and the server's
# own validation becomes the only guarantee of shape.
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Behaviour --------------------------------------------------------------
# IANA zone that decides when "today" flips for the daily leaderboard.
SCRAPYARD_TIMEZONE=Asia/Jerusalem

# Login background: a YouTube id, or `none` for the animated grid only.
# A file at apps/api/public/login/background.mp4 overrides this.
LOGIN_BACKGROUND_YOUTUBE_ID=xt_1gJkjdec

# --- Local development only -------------------------------------------------
# Render sets PORT=10000 itself; 3000 is just the local default.
PORT=3000

# Points at the Vite dev server. Leave this UNSET anywhere the API also serves
# the bundle (Render, `npm run preview`) so redirects stay relative and CORS
# stays off entirely.
WEB_ORIGIN=http://localhost:5173

# Render terminates TLS at its edge, so the hop to this process is plain HTTP.
# render.yaml sets this; locally you don't want it.
# TRUST_PROXY=true
