#!/usr/bin/env bash
#
# Scrapyard VM bootstrap. Runs as root on every boot; idempotent throughout, so
# a reboot re-checks everything rather than reinstalling it.
#
# Rendered by OpenTofu from infra/templates/startup.sh.tftpl.
# Secrets are NOT in here — they're fetched from Secret Manager at runtime using
# the instance's service account, because metadata is readable by any project
# viewer.
#
# Progress:  sudo journalctl -u google-startup-scripts -f
#
set -euo pipefail

LOG=/var/log/scrapyard-bootstrap.log
exec > >(tee -a "$LOG") 2>&1
echo "=== scrapyard bootstrap $(date -Is) ==="

APP_DIR=/opt/scrapyard
PROJECT_ID="${project_id}"

# ---------------------------------------------------------------------------
# 1. Swap.
#
# e2-micro has 1 GB of RAM. That runs the container comfortably (~150 MB) but
# is not enough to *build* the image — npm ci plus a Vite build will get
# OOM-killed. 2 GB of swap makes the build slow rather than fatal.
# ---------------------------------------------------------------------------
if [ ! -f /swapfile ]; then
  echo "--- creating 2G swapfile"
  fallocate -l 2G /swapfile || dd if=/dev/zero of=/swapfile bs=1M count=2048
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  grep -q '^/swapfile' /etc/fstab || echo '/swapfile none swap sw 0 0' >> /etc/fstab
  # Prefer RAM; only spill under real pressure.
  sysctl -w vm.swappiness=10
  grep -q 'vm.swappiness' /etc/sysctl.conf || echo 'vm.swappiness=10' >> /etc/sysctl.conf
fi

# ---------------------------------------------------------------------------
# 2. Docker + git
# ---------------------------------------------------------------------------
if ! command -v docker >/dev/null 2>&1; then
  echo "--- installing docker"
  export DEBIAN_FRONTEND=noninteractive
  apt-get update -qq
  apt-get install -y -qq ca-certificates curl gnupg git
  install -m 0755 -d /etc/apt/keyrings
  curl -fsSL https://download.docker.com/linux/debian/gpg \
    | gpg --dearmor -o /etc/apt/keyrings/docker.gpg
  chmod a+r /etc/apt/keyrings/docker.gpg
  echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/debian $(. /etc/os-release && echo "$VERSION_CODENAME") stable" \
    > /etc/apt/sources.list.d/docker.list
  apt-get update -qq
  apt-get install -y -qq docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
  systemctl enable --now docker
fi

# ---------------------------------------------------------------------------
# 3. Secrets, from Secret Manager
# ---------------------------------------------------------------------------
secret() {
  gcloud secrets versions access latest \
    --secret="$1" --project="$PROJECT_ID" 2>/dev/null
}

echo "--- reading secrets"
GOOGLE_CLIENT_ID="$(secret scrapyard-google-client-id)"
GOOGLE_CLIENT_SECRET="$(secret scrapyard-google-client-secret)"
JWT_SECRET="$(secret scrapyard-jwt-secret)"
TUNNEL_TOKEN="$(secret scrapyard-tunnel-token)"

for name in GOOGLE_CLIENT_ID GOOGLE_CLIENT_SECRET JWT_SECRET TUNNEL_TOKEN; do
  if [ -z "$${!name}" ]; then
    echo "FATAL: secret for $name is empty. Check Secret Manager and the VM's IAM binding." >&2
    exit 1
  fi
done

# ---------------------------------------------------------------------------
# 4. Source
# ---------------------------------------------------------------------------
%{ if uses_github_auth ~}
GITHUB_TOKEN="$(secret scrapyard-github-token)"
CLONE_URL="$(echo "${git_repo_url}" | sed "s#https://#https://x-access-token:$GITHUB_TOKEN@#")"
%{ else ~}
CLONE_URL="${git_repo_url}"
%{ endif ~}

if [ ! -d "$APP_DIR/.git" ]; then
  echo "--- cloning"
  rm -rf "$APP_DIR"
  git clone --depth 1 --branch "${git_branch}" "$CLONE_URL" "$APP_DIR"
else
  echo "--- updating"
  git -C "$APP_DIR" remote set-url origin "$CLONE_URL"
  git -C "$APP_DIR" fetch --depth 1 origin "${git_branch}"
  git -C "$APP_DIR" reset --hard "origin/${git_branch}"
fi

# Drop the token from the stored remote so it isn't sitting in .git/config.
git -C "$APP_DIR" remote set-url origin "${git_repo_url}"

# ---------------------------------------------------------------------------
# 5. Environment file
#
# WEB_ORIGIN is deliberately empty: this container serves the bundle itself, so
# post-login redirects stay relative and CORS is disabled entirely.
# TRUST_PROXY=1 because Cloudflare terminates TLS — without it request.protocol
# and request.ip would describe the plain-HTTP hop from cloudflared.
# ---------------------------------------------------------------------------
echo "--- writing .env"
umask 077
cat > "$APP_DIR/.env" <<ENVEOF
NODE_ENV=production
PORT=3000
DATABASE_DIR=/data

GOOGLE_CLIENT_ID=$GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=$GOOGLE_CLIENT_SECRET
GOOGLE_CALLBACK_URL=https://${public_hostname}/api/auth/google/callback
JWT_SECRET=$JWT_SECRET

ALLOWED_WORKSPACE_DOMAINS=${allowed_workspace_domains}
ADMIN_EMAILS=${admin_emails}

WEB_ORIGIN=
TRUST_PROXY=1
SCRAPYARD_TIMEZONE=${app_timezone}
LOGIN_BACKGROUND_YOUTUBE_ID=${login_background_youtube_id}

TUNNEL_TOKEN=$TUNNEL_TOKEN
ENVEOF
chmod 600 "$APP_DIR/.env"

# ---------------------------------------------------------------------------
# 6. Build and run
# ---------------------------------------------------------------------------
cd "$APP_DIR"
echo "--- building (slow on e2-micro; swap is doing the work)"
docker compose --profile tunnel up -d --build

# ---------------------------------------------------------------------------
# 7. Nightly backup
#
# The volume IS the database, and the billing killswitch can destroy it. This
# is a same-disk copy, so it protects against application mistakes, not disk
# loss — pull the tarballs off the box, or use the in-app admin export, for
# anything you actually care about.
# ---------------------------------------------------------------------------
mkdir -p /var/backups/scrapyard
cat > /usr/local/bin/scrapyard-backup <<'BAKEOF'
#!/usr/bin/env bash
set -euo pipefail
VOL=$(docker volume ls --format '{{.Name}}' | grep -m1 'scrapyard-db' || true)
[ -z "$VOL" ] && { echo "no scrapyard-db volume yet"; exit 0; }
OUT=/var/backups/scrapyard/scrapyard-$(date +%F).tar.gz
docker run --rm -v "$VOL":/data -v /var/backups/scrapyard:/backup \
  alpine tar czf "/backup/$(basename "$OUT")" -C /data .
# Keep two weeks.
find /var/backups/scrapyard -name 'scrapyard-*.tar.gz' -mtime +14 -delete
echo "backed up to $OUT"
BAKEOF
chmod +x /usr/local/bin/scrapyard-backup

cat > /etc/cron.d/scrapyard-backup <<'CRONEOF'
17 3 * * * root /usr/local/bin/scrapyard-backup >> /var/log/scrapyard-backup.log 2>&1
CRONEOF
chmod 644 /etc/cron.d/scrapyard-backup

echo "=== bootstrap complete $(date -Is) ==="
echo "Health: $(curl -fsS --max-time 5 http://127.0.0.1:3000/api/health || echo 'not up yet')"
