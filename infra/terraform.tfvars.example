# Copy to terraform.tfvars and fill in. That file is gitignored — it holds
# your OAuth client secret and tunnel token.
#
#   cp terraform.tfvars.example terraform.tfvars

# --- Project ----------------------------------------------------------------
project_id      = "scrapyard-prod"
billing_account = "01A2B3-4C5D6E-7F8G9H" # gcloud beta billing accounts list

# --- Location ---------------------------------------------------------------
# Only us-west1, us-central1 and us-east1 qualify for the free e2-micro.
region = "us-central1"
zone   = "us-central1-a"

# --- Source -----------------------------------------------------------------
git_repo_url = "https://github.com/you/scrapyard.git"
git_branch   = "main"
# Only needed if the repo is private. Stored in Secret Manager.
# github_token = "ghp_..."

# --- App --------------------------------------------------------------------
public_hostname           = "scrapyard.cytactic.com"
allowed_workspace_domains = "cytactic.com"
admin_emails              = "amit@cytactic.com"
app_timezone              = "Asia/Jerusalem"

# Keep the YouTube embed on the free tier — self-hosting a video would consume
# the 1 GB/month egress allowance in roughly 500 page views.
login_background_youtube_id = "xt_1gJkjdec"

# --- Secrets ----------------------------------------------------------------
google_client_id     = "....apps.googleusercontent.com"
google_client_secret = "GOCSPX-..."
tunnel_token         = "eyJhIjoi..." # the string after --token

# --- Billing protection -----------------------------------------------------
budget_amount_usd   = 1
budget_alert_emails = ["amit@cytactic.com"]

# Set to false if you'd rather never risk the disk. But then nothing actually
# stops spending — a budget alert is only an email.
enable_billing_killswitch = true
